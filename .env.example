APP_NAME=SIRIM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Lima

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sirim
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="sirim@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# RENIEC: completar solo con las credenciales y especificaciones entregadas al hospital.
# No usar endpoints ni servicios de terceros no autorizados.
RENIEC_URL=
RENIEC_TOKEN=
RENIEC_METHOD=POST
RENIEC_DNI_FIELD=dni
RENIEC_TIMEOUT=15
